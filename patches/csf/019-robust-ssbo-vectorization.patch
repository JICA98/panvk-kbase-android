+         break;
+      }
+      return then_src && vector_lane(then_src->src.ssa, lane, components);
+   }
+
+   nir_shader *specialize_size(unsigned size)
+   {
+      nir_shader *shader = nir_shader_clone(NULL, b->shader);
+      nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+      nir_intrinsic_instr *query = nullptr;
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic ==
+                   nir_intrinsic_get_ssbo_size) {
+               query = nir_instr_as_intrinsic(instr);
+               break;
+            }
+         }
+         if (query)
+            break;
+      }
+      if (!query) {
+         ADD_FAILURE();
+         ralloc_free(shader);
+         return nullptr;
+      }
+      nir_builder builder = nir_builder_create(impl);
+      builder.cursor = nir_before_instr(&query->instr);
+      nir_def_replace(&query->def, nir_imm_int(&builder, size));
+      nir_opt_constant_folding(shader);
+      nir_opt_dead_cf(shader);
+      return shader;
+   }
+
+   nir_shader *specialize_all_sizes(unsigned size)
+   {
+      nir_shader *shader = nir_shader_clone(NULL, b->shader);
+      nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+      nir_builder builder = nir_builder_create(impl);
+      bool found = false;
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic ||
+                nir_instr_as_intrinsic(instr)->intrinsic !=
+                   nir_intrinsic_get_ssbo_size)
+               continue;
+            nir_intrinsic_instr *query = nir_instr_as_intrinsic(instr);
+            builder.cursor = nir_before_instr(&query->instr);
+            nir_def_replace(&query->def, nir_imm_int(&builder, size));
+            found = true;
+         }
+      }
+      if (!found) {
+         ADD_FAILURE();
+         ralloc_free(shader);
+         return nullptr;
+      }
+      nir_opt_constant_folding(shader);
+      nir_opt_dead_cf(shader);
+      return shader;
+   }
+
+   nir_shader *specialize_bias_sizes(unsigned extra)
+   {
+      nir_shader *shader = nir_shader_clone(NULL, b->shader);
+      nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+      nir_builder builder = nir_builder_create(impl);
+      unsigned query_index = 0;
+      bool found = false;
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic ||
+                nir_instr_as_intrinsic(instr)->intrinsic !=
+                   nir_intrinsic_get_ssbo_size)
+               continue;
+            nir_intrinsic_instr *query = nir_instr_as_intrinsic(instr);
+            builder.cursor = nir_before_instr(&query->instr);
+            nir_def_replace(&query->def,
+                            nir_imm_int(&builder, query_index * 4 + extra));
+            query_index++;
+            found = true;
+         }
+      }
+      if (!found) {
+         ADD_FAILURE();
+         ralloc_free(shader);
+         return nullptr;
+      }
+      nir_opt_constant_folding(shader);
+      nir_opt_dead_cf(shader);
+      return shader;
+   }
+
+   unsigned count_ifs()
+   {
+      unsigned result = 0;
+      nir_foreach_block(block, b->impl) {
+         if (nir_block_get_following_if(block))
+            result++;
+      }
+      return result;
+   }
+
+   void check_specialized_width(unsigned width)
+   {
+      nir_def *res = resource();
+      nir_def *base = nir_imm_int(b, 64);
+      nir_intrinsic_instr *loads[4];
+      for (unsigned i = 0; i < width; i++)
+         loads[i] = load(res, nir_iadd_imm(b, base, 4 * i));
+
+      switch (width) {
+      case 2:
+         nir_vec2(b, &loads[0]->def, &loads[1]->def);
+         break;
+      case 3:
+         nir_vec3(b, &loads[0]->def, &loads[1]->def, &loads[2]->def);
+         break;
+      case 4:
+         nir_vec4(b, &loads[0]->def, &loads[1]->def, &loads[2]->def,
+                  &loads[3]->def);
+         break;
+      default:
+         ADD_FAILURE();
+         return;
+      }
+
+      ASSERT_TRUE(nir_opt_vectorize_robust_ssbo_loads(b->shader));
+      nir_shader *exact = specialize_size(64 + 4 * width);
+      nir_shader *partial = specialize_size(64 + 4 * (width - 1));
+      nir_shader *empty = specialize_size(0);
+      ASSERT_NE(exact, nullptr);
+      ASSERT_NE(partial, nullptr);
+      ASSERT_NE(empty, nullptr);
+
+      EXPECT_EQ(count_shader_loads(exact, width), 1u);
+      EXPECT_EQ(count_shader_loads_at(exact, width, 64), 1u);
+      EXPECT_EQ(count_shader_loads(partial, width), 0u);
+      EXPECT_EQ(count_shader_loads(partial, 1), width);
+      EXPECT_EQ(count_shader_loads(empty, width), 0u);
+      EXPECT_EQ(count_shader_loads(empty, 1), width);
+      for (unsigned i = 0; i < width; i++) {
+         EXPECT_EQ(count_shader_loads_at(partial, 1, 64 + 4 * i), 1u);
+         EXPECT_EQ(count_shader_loads_at(empty, 1, 64 + 4 * i), 1u);
+      }
+
+      ralloc_free(exact);
+      ralloc_free(partial);
+      ralloc_free(empty);
+   }
+};
