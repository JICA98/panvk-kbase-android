+   nir_vec2(b, &first->def, &second->def);
+
+   nir_opt_cse(b->shader);
+   ASSERT_TRUE(nir_opt_vectorize_robust_ssbo_loads(b->shader));
+   nir_validate_shader(b->shader, NULL);
+   EXPECT_EQ(count_load_components(2), 1u);
+}
+
+TEST_F(nir_opt_vectorize_robust_ssbo_loads_test,
+       normalizes_distinct_z_descriptor_extracts_with_copy_prop)
+{
+   nir_def *common = nir_vec3(b, nir_imm_int(b, 0x1000000),
+                              nir_imm_int(b, 0), nir_imm_int(b, 0));
+   nir_def *dynamic = nir_undef(b, 1, 32);
+   for (unsigned i = 0; i < 2; i++) {
+      nir_def *packed = nir_vec3(b, nir_channel(b, common, 0),
+                                 nir_channel(b, common, 1),
+                                 nir_iadd_imm(b, dynamic, i * 4));
+      nir_def *res = nir_channels(b, packed, 0x3);
+      load(res, nir_channel(b, packed, 2));
+   }
+
+   nir_shader *without_copy_prop = nir_shader_clone(NULL, b->shader);
+   nir_opt_constant_folding(without_copy_prop);
+   nir_opt_cse(without_copy_prop);
+   EXPECT_FALSE(nir_opt_vectorize_robust_ssbo_loads(without_copy_prop));
+   ralloc_free(without_copy_prop);
+
+   nir_opt_copy_prop(b->shader);
+   nir_opt_constant_folding(b->shader);
+   nir_opt_cse(b->shader);
+   EXPECT_TRUE(nir_opt_vectorize_robust_ssbo_loads(b->shader));
+   nir_validate_shader(b->shader, NULL);
+   EXPECT_EQ(count_load_components(2), 1u);
+}
+
+TEST_F(nir_opt_vectorize_robust_ssbo_loads_test, rejects_wrapped_contiguous_offsets)
+{
+   nir_def *res = resource();
+   load(res, nir_imm_int(b, UINT32_MAX));
+   load(res, nir_imm_int(b, 3));
+
+   EXPECT_FALSE(nir_opt_vectorize_robust_ssbo_loads(b->shader));
+   EXPECT_EQ(count(nir_intrinsic_load_ssbo), 2u);
+}
+
