From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jica98 <jica.etzc@gmail.com>
Date: Wed, 30 Sep 2026 03:20:50 +0530
Subject: [PATCH 6/7] panvk: allow 4-byte storage buffer offsets on Valhall

Valhall memory accesses do not need natural alignment, so storage
buffers can be bound at dword granularity. Applications that otherwise
pass sub-alignment offsets to their shaders can bind buffers directly.

Generated-by: LLM
---
 src/panfrost/vulkan/panvk_vX_physical_device.c | 3 +--
 src/panfrost/vulkan/panvk_vX_shader.c          | 2 +-
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_vX_physical_device.c b/src/panfrost/vulkan/panvk_vX_physical_device.c
index 6d986830..50b1b84e 100644
--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -971,8 +971,7 @@ panvk_per_arch(get_physical_device_properties)(
       .minTexelBufferOffsetAlignment = 16,
       /* Always aligned on a uniform slot (vec4). */
       .minUniformBufferOffsetAlignment = 16,
-      /* LOAD.i128 and LD_PKA.i128 which require 16B alignment */
-      .minStorageBufferOffsetAlignment = 16,
+      .minStorageBufferOffsetAlignment = PAN_ARCH >= 9 ? 4 : 16,
       /* Signed 4-bit value. */
       .minTexelOffset = -8,
       .maxTexelOffset = 7,
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index 72d7e83b..de155118 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -423,7 +423,7 @@ panvk_get_spirv_options(UNUSED struct vk_physical_device *vk_pdev,
       .phys_ssbo_addr_format = nir_address_format_64bit_global,
       .shared_addr_format = nir_address_format_32bit_offset,
       .min_ubo_alignment = 16,
-      .min_ssbo_alignment = 16,
+      .min_ssbo_alignment = PAN_ARCH >= 9 ? 4 : 16,
       .debug_info = pan_want_debug_info(PAN_ARCH),
    };
 }
