 {
    VkMemoryPropertyFlags req_props = VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
 
-   if (wsi->sw)
-      req_props |= VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+   if (wsi->sw) {
+      const VkMemoryPropertyFlags cached = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                           VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+      int cached_non_coherent = -1;
+      u_foreach_bit(t, type_bits) {
+         const VkMemoryPropertyFlags flags =
+            wsi->memory_props.memoryTypes[t].propertyFlags;
+         if ((flags & (cached | req_props)) == (cached | req_props))
+            return t;
+         if ((flags & cached) == cached && cached_non_coherent < 0)
+            cached_non_coherent = t;
+      }
+      if (cached_non_coherent >= 0)
+         return cached_non_coherent;
+   }
 
    return wsi_select_memory_type(wsi, req_props, 0 /* deny_props */, type_bits);
 }
 
+void
+wsi_image_invalidate_cpu_map(const struct wsi_swapchain *chain,
+                             const struct wsi_image *image)
+{
+   if (!image->cpu_map_non_coherent)
+      return;
+
+   const VkMappedMemoryRange range = {
+      .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+      .memory = image->cpu_map_memory,
+      .offset = 0,
+      .size = VK_WHOLE_SIZE,
+   };
+   chain->wsi->InvalidateMappedMemoryRanges(chain->device, 1, &range);
+}
+
+static void
+wsi_image_note_cpu_map(const struct wsi_swapchain *chain,
+                       struct wsi_image *image, VkDeviceMemory memory,
+                       uint32_t type_index)
+{
+   image->cpu_map_memory = memory;
+   image->cpu_map_non_coherent =
+      !(chain->wsi->memory_props.memoryTypes[type_index].propertyFlags &
+        VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+}
