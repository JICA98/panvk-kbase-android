+static void
+panvk_load_env_file(void)
+{
+   Dl_info info;
+   if (!dladdr((void *)panvk_load_env_file, &info) || !info.dli_fname)
+      return;
+
+   char path[PATH_MAX];
+   const char *slash = strrchr(info.dli_fname, '/');
+   if (!slash)
+      return;
+   int dir_len = (int)(slash - info.dli_fname);
+   if (snprintf(path, sizeof(path), "%.*s/panvk-env.txt", dir_len,
+                info.dli_fname) >= (int)sizeof(path))
+      return;
+
+   FILE *f = fopen(path, "r");
+   if (!f)
+      return;
+
+   char line[512];
+   while (fgets(line, sizeof(line), f)) {
+      line[strcspn(line, "\r\n")] = '\0';
+      char *eq = strchr(line, '=');
+      if (line[0] == '#' || !eq || eq == line)
+         continue;
+      *eq = '\0';
+      setenv(line, eq + 1, 1);
+      mesa_logi("panvk: env file %s=%s", line, eq + 1);
+   }
+   fclose(f);
+}
+#endif
