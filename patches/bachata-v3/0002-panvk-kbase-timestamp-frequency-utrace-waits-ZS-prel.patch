+               (int)(slash - info.dli_fname), info.dli_fname);
+   }
+
+   uint64_t now = os_time_get_nano();
+   if (now >= next_check_ns) {
+      open_state = access(gate_path, F_OK) == 0;
+      next_check_ns = now + 250000000ull;
+   }
+   return open_state;
