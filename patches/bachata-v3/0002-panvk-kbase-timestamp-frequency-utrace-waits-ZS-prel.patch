+static bool
+kbase_utrace_gate_open(void)
+{
+   static char gate_path[PATH_MAX];
+   static uint64_t next_check_ns;
+   static bool open_state;
+
+   if (!gate_path[0]) {
+      Dl_info info;
+      const char *slash;
+      if (!dladdr((void *)kbase_utrace_gate_open, &info) || !info.dli_fname ||
+          !(slash = strrchr(info.dli_fname, '/')))
+         return true;
