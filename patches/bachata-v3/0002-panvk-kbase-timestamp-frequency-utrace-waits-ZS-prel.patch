+static void
+panvk_barrier_stats_add(uint32_t kind, uint64_t ss, uint64_t ds, uint64_t sa,
+                        uint64_t da, uint32_t ol, uint32_t nl)
+{
+   static struct panvk_barrier_stat stats[96];
+   static unsigned nstats;
+   static uint64_t next_dump_ns, total;
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+
+   simple_mtx_lock(&lock);
+   total++;
+   unsigned i;
+   for (i = 0; i < nstats; i++) {
+      struct panvk_barrier_stat *e = &stats[i];
+      if (e->kind == kind && e->src_stage == ss && e->dst_stage == ds &&
+          e->src_access == sa && e->dst_access == da && e->old_layout == ol &&
+          e->new_layout == nl)
+         break;
+   }
+   if (i == nstats && nstats < ARRAY_SIZE(stats))
+      stats[nstats++] = (struct panvk_barrier_stat){kind, ss, ds, sa, da, ol, nl, 0};
+   if (i < ARRAY_SIZE(stats))
+      stats[i].count++;
+
+   uint64_t now = os_time_get_nano();
+   if (!next_dump_ns)
+      next_dump_ns = now + 5000000000ull;
+   if (now >= next_dump_ns) {
+      next_dump_ns = now + 5000000000ull;
+      mesa_logw("panvk barrier stats: total=%" PRIu64 " entries=%u", total,
+                nstats);
+      for (unsigned j = 0; j < nstats; j++) {
+         struct panvk_barrier_stat *e = &stats[j];
+         if (e->count * 50 < total)
+            continue;
+         mesa_logw("  n=%" PRIu64 " kind=%u src=%#" PRIx64 "/%#" PRIx64
+                   " dst=%#" PRIx64 "/%#" PRIx64 " layout=%u->%u",
+                   e->count, e->kind, e->src_stage, e->src_access,
+                   e->dst_stage, e->dst_access, e->old_layout, e->new_layout);
+      }
+      for (unsigned j = 0; j < nstats; j++)
+         stats[j].count = 0;
+      total = 0;
+   }
+   simple_mtx_unlock(&lock);
+}
