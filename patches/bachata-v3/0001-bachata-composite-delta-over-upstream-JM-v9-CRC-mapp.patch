diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index bc1bc0fc..8e62becf 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -25,9 +25,206 @@
 #include "panvk_queue.h"
 
 #include "vk_drm_syncobj.h"
+#include "vk_common_entrypoints.h"
 #include "vk_framebuffer.h"
 
 #include "drm-uapi/panfrost_drm.h"
+#ifdef HAVE_PAN_KMOD_KBASE
+#include "drm-uapi/mali_kbase_ioctl.h"
+#include <poll.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <sys/ioctl.h>
+#endif
+
+#ifdef HAVE_PAN_KMOD_KBASE
+struct panvk_jm_atom_v11_38 {
+   uint64_t jc;
+   uint64_t udata[2];
+   uint64_t extres_list;
+   uint16_t nr_extres;
+   uint16_t compat_core_req;
+   struct {
+      uint8_t atom_id;
+      uint8_t dependency_type;
+   } pre_dep[2];
+   uint8_t atom_number;
+   uint8_t prio;
+   uint8_t device_nr;
+   uint8_t padding1;
+   uint32_t core_req;
+};
+
+struct panvk_jm_event_v11_38 {
+   uint32_t event_code;
+   uint8_t atom_number;
+   uint8_t padding[3];
+   uint64_t udata[2];
+};
+
+static_assert(sizeof(struct panvk_jm_atom_v11_38) == 48, "JM atom size");
+static_assert(offsetof(struct panvk_jm_atom_v11_38, atom_number) == 40,
+              "JM atom number offset");
+static_assert(offsetof(struct panvk_jm_atom_v11_38, core_req) == 44,
+              "JM core request offset");
+static_assert(sizeof(struct panvk_jm_event_v11_38) == 24, "JM event size");
+
+static pthread_mutex_t panvk_jm_submit_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t panvk_jm_submission_serial;
+
+static bool
+panvk_uses_kbase(const struct panvk_device *dev)
+{
+   const struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
+   return phys_dev->kbase_node_path[0] != '\0';
+}
+
+static VkResult
+panvk_kbase_submit_and_wait(struct panvk_device *dev, uint64_t jc,
+                            uint32_t core_req)
+{
+   const struct pan_kmod_dev *kmod = dev->kmod.dev;
+   if (kmod->props.gpu_id != 0x90930010 ||
+       kmod->driver.version.major != 11 ||
+       kmod->driver.version.minor != 38)
+      return vk_device_set_lost(&dev->vk, "unsupported JM Kbase ABI");
+
+   VkResult result;
+   int ret = pthread_mutex_lock(&panvk_jm_submit_lock);
+   if (ret)
+      return vk_device_set_lost(&dev->vk, "JM submit lock failed: %d", ret);
+
+   if (vk_device_is_lost(&dev->vk)) {
+      pthread_mutex_unlock(&panvk_jm_submit_lock);
+      return VK_ERROR_DEVICE_LOST;
+   }
+
+   const uint64_t serial = ++panvk_jm_submission_serial;
+   struct panvk_jm_atom_v11_38 atom = {
+      .jc = jc,
+      .udata = {0x50414e564b4a4d00ull, serial},
+      .atom_number = 1 + ((serial - 1) % 254),
+      .core_req = core_req,
+   };
+   struct kbase_ioctl_job_submit submit = {
+      .addr = (uint64_t)(uintptr_t)&atom,
+      .nr_atoms = 1,
+      .stride = sizeof(atom),
+   };
+
+   if (ioctl(dev->drm_fd, KBASE_IOCTL_JOB_SUBMIT, &submit)) {
+      ret = errno;
+      goto fail;
+   }
+
+   struct pollfd pfd = {.fd = dev->drm_fd, .events = POLLIN};
+   while ((ret = poll(&pfd, 1, -1)) < 0 && errno == EINTR)
+      ;
+   if (ret <= 0 || !(pfd.revents & POLLIN)) {
+      ret = ret < 0 ? errno : EIO;
+      goto fail;
+   }
+
+   struct panvk_jm_event_v11_38 event = {0};
+   ssize_t bytes;
+   do {
+      bytes = read(dev->drm_fd, &event, sizeof(event));
+   } while (bytes < 0 && errno == EINTR);
+   if (bytes != sizeof(event)) {
+      ret = bytes < 0 ? errno : EIO;
+      goto fail;
+   }
+   if (event.event_code != 1 || event.atom_number != atom.atom_number ||
+       event.udata[0] != atom.udata[0] || event.udata[1] != atom.udata[1]) {
+      ret = EIO;
+      goto fail;
+   }
+
+   pthread_mutex_unlock(&panvk_jm_submit_lock);
+   return VK_SUCCESS;
+
+fail:
+   result = vk_device_set_lost(&dev->vk, "JM Kbase submission failed: %d", ret);
+   pthread_mutex_unlock(&panvk_jm_submit_lock);
+   return result;
+}
+
+static VkResult
+panvk_kbase_submit_batch(struct panvk_gpu_queue *queue,
+                         struct panvk_cmd_buffer *cmdbuf,
+                         struct panvk_batch *batch)
+{
+   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
+
+   if (batch->issued) {
+      util_dynarray_foreach(&batch->jobs, void *, job)
+         memset((*job), 0, 4 * 4);
+
+      if (batch->tiler.ctx_descs.cpu) {
+         memcpy(batch->tiler.heap_desc.cpu, &batch->tiler.heap_templ,
+                sizeof(batch->tiler.heap_templ));
+
+         struct mali_tiler_context_packed *ctxs = batch->tiler.ctx_descs.cpu;
+         for (uint32_t i = 0; i < batch->fb.layer_count; i++)
+            memcpy(&ctxs[i], &batch->tiler.ctx_templ, sizeof(*ctxs));
+      }
+      panvk_pool_flush_maps(&cmdbuf->desc_pool);
+   }
+
+   pan_kmod_flush_bo_map_syncs(dev->kmod.dev);
+
+   if (batch->vtc_jc.first_job) {
+      VkResult result = panvk_kbase_submit_and_wait(
+         dev, batch->vtc_jc.first_job, 0x16);
+      if (result != VK_SUCCESS)
+         return result;
+   }
