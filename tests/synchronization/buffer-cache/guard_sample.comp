#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform utextureBuffer source;

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
    uint destination[];
};

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= 1024u)
        return;

    destination[index] = texelFetch(source, int(index)).r ^ 0xa5a5a5a5u;
}
